# --- IG Publisher / SUSHI build artifacts (regenerated on every build) ---
# The generated IG website. Never commit it; previews are published via CI.
output/
# IG Publisher scratch space.
temp/
# The template package the IG Publisher extracts into ./template at build
# time. Why: this repo REFERENCES the template by version in ig.ini; the
# extracted copy is a build artifact. (A deliberate vendored bring-up copy
# would live under a different, tracked path.)
template/
# Downloaded FHIR package cache.
input-cache/
# FSH -> FHIR JSON output generated by SUSHI.
fsh-generated/
# The IG Publisher jar itself — downloaded, version-pinned, never committed.
publisher.jar

# --- Tooling ---
node_modules/

# --- OS / editor noise ---
.DS_Store
*.log

# Raw harvested guide HTML (migration evidence, referenced by path from
# migration-log/run.log; kept out of the branch to keep the diff reviewable).
migration-log/guide-harvest/html/

# Per-resource translation TEMPLATES the IG Publisher generates at the repo
# root on every build (.po/.xliff). Build output, not source: the maintained
# translations live under input/translations/.
/translations/

# Requirements resource the IG Publisher derives from the narrative on every
# build and drops at the repo root. Build output, not source.
/Requirements-fromNarrative.json
